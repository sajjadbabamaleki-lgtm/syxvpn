# ---------------------------------------------------------------------------
# SixVPN control plane — environment
# Copy to .env and fill in. Never commit a filled-in .env.
# ---------------------------------------------------------------------------

NODE_ENV=production
PORT=8787
HOST=0.0.0.0
# The database file. Deliberately not renamed with the product: a deployment
# that is running has its data under this name, and pointing the control plane
# somewhere else would start it on an empty database as if nothing had been sold.
DB_PATH=/data/cvpn.db
LOG_LEVEL=info

# Public origin of the control plane, used when rendering subscription URLs.
# Set this to the hostname subscribers actually fetch from.
PUBLIC_BASE_URL=https://control.sixvpn.pro

# Browsers calling the API from the dashboard origin. Comma separated.
# Leave empty to allow any origin (development only).
CORS_ORIGINS=https://control.sixvpn.pro,https://sixvpn.pro,https://www.sixvpn.pro

# --- Administrator ---------------------------------------------------------
# Required in production. Either a plaintext bootstrap password (>=12 chars)
# or a pre-computed hash from: node server/scripts/hash-password.js
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
# ADMIN_PASSWORD_HASH=scrypt$16384$8$1$...
ADMIN_SESSION_TTL_SECONDS=43200

# --- Secret encryption -----------------------------------------------------
# Required in production. Encrypts gateway agent keys and upstream egress
# credentials at rest. Generate with: openssl rand -base64 32
# Rotating this value invalidates every stored agent key and egress secret.
SECRET_KEY=

# --- Gateway agents --------------------------------------------------------
# Accepted clock skew for signed agent requests (also the replay window).
AGENT_MAX_SKEW_SECONDS=300
# Heartbeat age after which an agent is reported as stale.
AGENT_STALE_SECONDS=180
# Age after which agent-reported egress health is no longer trusted.
EGRESS_STALE_SECONDS=600

# --- Health monitor --------------------------------------------------------
HEALTH_MONITOR_ENABLED=true
HEALTH_INTERVAL_SECONDS=60
HEALTH_TCP_TIMEOUT_MS=4000
HEALTH_PROBE_TIMEOUT_MS=6000
HEALTH_FAILURE_THRESHOLD=2

# --- Additional inbound protocols ------------------------------------------
# Extra ways into a gateway -- Shadowsocks, trojan, a second REALITY -- next to
# the one it has always had. Off means the control plane generates, serves and
# probes exactly what it did before the feature existed, whatever is configured.
# See docs/ADAPTIVE-INBOUNDS.md before turning either of these up.
ADAPTIVE_INBOUNDS=false
# Share of subscribers told that the extra doors exist. Stable per subscriber,
# and raising it never takes the feature away from somebody who already had it.
ADAPTIVE_INBOUNDS_PERCENT=0

# --- Rate limits (requests per minute) -------------------------------------
RATE_LIMIT_LOGIN=10
RATE_LIMIT_SUB=30
RATE_LIMIT_API=600
RATE_LIMIT_AGENT=600

# Set to true only when running behind a reverse proxy you control, so that
# X-Forwarded-For is trusted for rate limiting.
TRUST_PROXY=false

# --- Dashboard build -------------------------------------------------------
# Base URL the dashboard calls. Leave empty to use the same origin.
VITE_API_URL=

# --- Storefront (customer sales) -------------------------------------------
SHOP_ENABLED=true
SHOP_SESSION_TTL_SECONDS=2592000
# How customers reach you. Shown on the web storefront and on the Android app's
# Support tab, which turns "@handle" into a t.me link and an address into mail,
# so it can be changed here without shipping a new app.
SUPPORT_CONTACT=

# --- USDT (TRC-20) payments -------------------------------------------------
# The TRON address that receives customer payments. The control plane only ever
# READS the chain; it holds no private key and cannot move funds.
# Leave empty to run the control plane without selling anything: plans are still
# listed, but opening an order is refused instead of pretending to take money.
TRON_ADDRESS=
TRON_API_URL=https://api.trongrid.io
# Free key from trongrid.io. Without it you share a low anonymous rate limit.
TRON_API_KEY=
# Mainnet USDT TRC-20 contract. Change only for a testnet.
USDT_CONTRACT=TR7NHqjeKQxGTCi8q8ZY4pL8otSzgjLj6t
# How long a customer has to send the exact amount before the order expires.
PAYMENT_WINDOW_MINUTES=60
PAYMENT_POLL_SECONDS=30
# Blocks to wait before a payment counts as final (TRON finality ~19 blocks).
PAYMENT_CONFIRMATIONS=19
PAYMENT_WATCHER_ENABLED=true
MAX_OPEN_ORDERS=2

# --- Support assistant ------------------------------------------------------
# A bot that answers support questions in Telegram, reads the asker's own
# subscription and server health through a small set of read-only tools, and
# hands the conversation to a person when it cannot answer. Off by default, and
# off entirely without an API key -- a support channel that cannot answer is
# worse than none. See docs/SUPPORT-ASSISTANT.md before turning it on.
ASSISTANT_ENABLED=false
ANTHROPIC_API_KEY=
ASSISTANT_MODEL=claude-opus-5
# How hard the model thinks per reply: low | medium | high.
ASSISTANT_EFFORT=medium

# From @BotFather. Without it the assistant can be created but cannot speak.
TELEGRAM_BOT_TOKEN=
# Secret path segment *and* header on the webhook, checked both ways.
# Generate with: openssl rand -hex 24
TELEGRAM_WEBHOOK_SECRET=
# The bot's public @name, so the storefront can send a customer to the chat the
# link code is for. Without it the storefront shows no linking step at all.
TELEGRAM_BOT_USERNAME=
# The chat a person answers from: where handovers are announced and where
# /waiting, /reply and /bot work. Your own numeric chat id, or a group's.
TELEGRAM_OPERATOR_CHAT_ID=
