<?xml version="1.0" encoding="utf-8"?>
<!--
  The mark is artwork, not geometry: white shapes with a lime glow behind
  them. A VectorDrawable cannot blur, so the foreground is the supplied image
  with its black turned into transparency rather than a set of paths that
  would have to leave the glow out.

  The background stays a flat colour. It is what the launcher parallaxes
  against, and the artwork's own black is the same #0D0D0D, so the seam does
  not show when a launcher shifts the two layers apart.

  The foreground is inset because an adaptive icon is not shown at the size it
  is drawn: the launcher masks the 108dp layers down to a 72dp viewport, so
  anything outside the middle two thirds is cropped and everything inside is
  scaled up. The supplied artwork fills 58% of the canvas across and 68% down,
  which lands it flush against that mask — the mark touched all four edges and
  its top and bottom were clipped. A 20% inset on every side scales the artwork to 60%,
  bringing the ink to roughly 38 x 44 of the 108dp canvas: comfortably inside
  the 66dp safe zone, with room to breathe on all four sides of the mask.
-->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/ic_launcher_background" />
    <foreground>
        <inset
            android:drawable="@mipmap/ic_launcher_foreground"
            android:insetLeft="20%"
            android:insetTop="20%"
            android:insetRight="20%"
            android:insetBottom="20%" />
    </foreground>
</adaptive-icon>
