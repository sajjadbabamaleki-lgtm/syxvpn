<?xml version="1.0" encoding="utf-8"?>
<!--
  The SixVPN mark, on the adaptive icon's 108dp canvas.

  Sized to 72dp across, which is the safe zone every launcher mask keeps: a
  circular mask, a squircle and a rounded square all cut somewhere different
  outside it, and a logo that reaches past it loses a different piece of itself
  on every phone.

  The same shape is in public/logo.svg and src/components/Logo.jsx. Changing one
  without the others is how a brand ends up with three logos.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <path
        android:fillColor="#5CD673"
        android:pathData="M84.86,72.54 A36,36 0 1 1 84.86,35.46 L71.87,43.26 A20.85,20.85 0 1 0 71.87,64.74 Z" />
    <path
        android:fillColor="#5CD673"
        android:pathData="M46.27,47.33 h15.45 v13.35 h-15.45 z" />
</vector>
