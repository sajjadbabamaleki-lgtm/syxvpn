# Reverse-proxy examples. Copy the block you need; Caddy obtains certificates
# automatically as long as the DNS records point here.
#
# Names this deployment uses:
#
#   syxvpn.pro           the public page          (may sit behind Cloudflare)
#   control.syxvpn.pro   API + storefront/console (may sit behind Cloudflare)
#   gw1.syxvpn.pro       a gateway                (MUST be DNS-only)
#
# A gateway is never proxied through Cloudflare. The tunnel is not ordinary web
# traffic, proxying it breaks the TLS the client expects to terminate at the
# gateway, and doing it would put this deployment on the wrong side of their
# terms. Grey cloud, always.

# ------------------------------------------------------------------ public site
syxvpn.pro, www.syxvpn.pro {
    encode zstd gzip

    # The landing page reads live prices from the control plane, and it asks its
    # own origin for them — there is no hostname typed into the page, so that a
    # deployment which serves the site and the API together needs no config at
    # all. This block is the case where they are not together: without this
    # matcher /api/* reaches the web container, the page is handed HTML where it
    # expected JSON, and the pricing section reports that plans are unavailable
    # while the control plane is serving them perfectly well.
    @api path /api/*
    handle @api {
        reverse_proxy 127.0.0.1:8787
    }

    # The Android build. It is a file on this host rather than something baked
    # into the web image, so publishing a new one is a copy and not a redeploy.
    # Alongside the apk goes its .sha256: an app installed from outside a store
    # is one the user has no other way to verify, and a checksum they can check
    # costs one line here.
    @dl path /download/*
    handle @dl {
        root * /opt/cvpn/downloads
        uri strip_prefix /download
        header Cache-Control "public, max-age=300"
        header ?Content-Type application/vnd.android.package-archive
        file_server
    }

    handle {
        reverse_proxy 127.0.0.1:8080
    }

    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains"
        X-Content-Type-Options nosniff
        Referrer-Policy strict-origin-when-cross-origin
    }
}

# ---------------------------------------------------------------- control plane
control.syxvpn.pro {
    encode zstd gzip

    # API and subscription endpoints. /telegram/* is the support bot's webhook:
    # it belongs to the API, and sending it to the web app instead would answer
    # Telegram with the storefront's HTML and no bot would ever reply. Its own
    # secret is in the path and in a header, both checked by the API.
    @api path /api/* /sub/* /telegram/* /health /readiness
    handle @api {
        reverse_proxy 127.0.0.1:8787
    }

    # The web app (storefront + operator console).
    handle {
        reverse_proxy 127.0.0.1:8080
    }

    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains"
        X-Content-Type-Options nosniff
        Referrer-Policy no-referrer
    }
}

# --------------------------------------------------------------------- gateway
# TLS terminates here; Xray listens on loopback with no TLS of its own, which is
# what `tlsMode: reverse-proxy` in the gateway registration means.
gw1.syxvpn.pro {
    encode zstd gzip

    # Must match the gateway's configured WebSocket path.
    @ws {
        path /your-secret-path
        header Connection *Upgrade*
        header Upgrade websocket
    }
    # Inside a handle, not beside one: Caddy evaluates handle before
    # reverse_proxy, so a catch-all handle next to a bare reverse_proxy answers
    # every request — including the upgrade — with the 404 below.
    handle @ws {
        reverse_proxy 127.0.0.1:10001
    }

    # Anything else looks like an ordinary site.
    handle {
        respond "" 404
    }
}
