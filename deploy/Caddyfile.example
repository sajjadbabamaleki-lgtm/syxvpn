# Reverse-proxy examples. Copy the block you need; Caddy obtains certificates
# automatically as long as the DNS records point here.
#
# Names this deployment uses:
#
#   sixvpn.pro           the public page          (may sit behind Cloudflare)
#   control.sixvpn.pro   API + storefront/console (may sit behind Cloudflare)
#   gw1.sixvpn.pro       a gateway                (MUST be DNS-only)
#
# A gateway is never proxied through Cloudflare. The tunnel is not ordinary web
# traffic, proxying it breaks the TLS the client expects to terminate at the
# gateway, and doing it would put this deployment on the wrong side of their
# terms. Grey cloud, always.

# ------------------------------------------------------------------ public site
sixvpn.pro, www.sixvpn.pro {
    encode zstd gzip
    reverse_proxy 127.0.0.1:8080

    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains"
        X-Content-Type-Options nosniff
        Referrer-Policy strict-origin-when-cross-origin
    }
}

# ---------------------------------------------------------------- control plane
control.sixvpn.pro {
    encode zstd gzip

    # API and subscription endpoints. /telegram/* is the support bot's webhook:
    # it belongs to the API, and sending it to the web app instead would answer
    # Telegram with the storefront's HTML and no bot would ever reply. Its own
    # secret is in the path and in a header, both checked by the API.
    @api path /api/* /sub/* /telegram/* /health /readiness
    handle @api {
        reverse_proxy 127.0.0.1:8787
    }

    # The web app (storefront + operator console).
    handle {
        reverse_proxy 127.0.0.1:8080
    }

    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains"
        X-Content-Type-Options nosniff
        Referrer-Policy no-referrer
    }
}

# --------------------------------------------------------------------- gateway
# TLS terminates here; Xray listens on loopback with no TLS of its own, which is
# what `tlsMode: reverse-proxy` in the gateway registration means.
gw1.sixvpn.pro {
    encode zstd gzip

    # Must match the gateway's configured WebSocket path.
    @ws {
        path /your-secret-path
        header Connection *Upgrade*
        header Upgrade websocket
    }
    # Inside a handle, not beside one: Caddy evaluates handle before
    # reverse_proxy, so a catch-all handle next to a bare reverse_proxy answers
    # every request — including the upgrade — with the 404 below.
    handle @ws {
        reverse_proxy 127.0.0.1:10001
    }

    # Anything else looks like an ordinary site.
    handle {
        respond "" 404
    }
}
